{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-pastebin-new",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-12",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "b-new.awsl.app", "custom_domain": true, "previews_enabled": false }],
